<%- include('./includes/head'); %>
</head>

<body class="bg-background font-jakarta text-text min-h-screen">
    <header class="h-16 bg-white/95 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="w-full px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <%- include('./includes/logo'); %>
                <div class="flex items-center gap-4">
                    <a href="/Hot-Stay/host/hosted-list" class="text-sm font-medium text-text hover:text-primary">Back to properties</a>
                    <%- include('./includes/profile icon'); %>
                </div>
            </div>
        </div>
    </header>

    <main class="py-12">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-2xl font-bold mb-6">Edit property</h1>

            <form method="POST" action="/Hot-Stay/host/<%= hotel._id %>/edit" class="space-y-4 bg-white p-6 rounded-lg shadow" novalidate>
                <div>
                    <label class="block text-sm font-semibold mb-2">Property Title</label>
                    <input name="name" value="<%= hotel.name %>" required minlength="3" class="w-full border px-3 py-2 rounded" />
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2">Location</label>
                    <input name="location" value="<%= hotel.location %>" required minlength="2" class="w-full border px-3 py-2 rounded" />
                </div>
                <div>
                    <label class="block text-sm font-semibold mb-2">Type</label>
                    <input name="type" value="<%= hotel.type %>" required minlength="2" class="w-full border px-3 py-2 rounded" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold mb-2">Guests</label>
                        <input name="guests" type="number" min="1" value="<%= hotel.guests %>" required class="w-full border px-3 py-2 rounded" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold mb-2">Price (per night)</label>
                        <input name="price" type="number" min="1" step="0.01" value="<%= hotel.price %>" required class="w-full border px-3 py-2 rounded" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Images (comma separated URLs)</label>
                    <input name="images" value="<%= hotel.images ? hotel.images.join(', ') : '' %>" required class="w-full border px-3 py-2 rounded" />
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Categories (comma separated)</label>
                    <input name="categories" value="<%= hotel.categories ? hotel.categories.join(', ') : '' %>" required class="w-full border px-3 py-2 rounded" />
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Host Email</label>
                    <input name="hostEmail" type="email" value="<%= hotel.hostEmail || '' %>" required class="w-full border px-3 py-2 rounded" />
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-2">Description</label>
                    <textarea name="description" rows="5" required minlength="20" class="w-full border px-3 py-2 rounded"><%= hotel.description %></textarea>
                </div>

                <div class="flex justify-end gap-3">
                    <a href="/Hot-Stay/host/hosted-list" class="px-6 py-2 border border-gray-300 rounded">Cancel</a>
                    <button type="submit" class="px-6 py-2 bg-secondary text-white rounded">Save changes</button>
                </div>
            </form>
        </div>
    </main>

</body>

</html>
