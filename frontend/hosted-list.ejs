<%- include('./includes/head'); %>
</head>

<body class="bg-background font-jakarta text-text min-h-screen">
    <header class="h-16 bg-white/95 backdrop-blur-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="w-full px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <%- include('./includes/logo'); %>
                <div class="flex items-center gap-4">
                    <a href="/Hot-Stay/home" class="text-sm font-medium text-text hover:text-primary">Browse stays</a>
                    <%- include('./includes/profile icon'); %>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <p class="text-sm uppercase tracking-[0.2em] text-gray-500">Host dashboard</p>
                <h1 class="text-3xl font-bold mt-2">My properties</h1>
            </div>
            <a href="/Hot-Stay/host/new" class="px-4 py-2 bg-secondary text-white rounded-md hover:bg-secondary/90">Add new property</a>
        </div>

        <% if (!hotels || hotels.length === 0) { %>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
                <h2 class="text-xl font-semibold mb-2">No properties yet</h2>
                <p class="text-gray-600">Your hosted listings will appear here once you create one.</p>
            </div>
        <% } else { %>
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                <% hotels.forEach((hotel) => { %>
                    <article class="bg-white rounded-xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-shadow">
                        <img src="<%= hotel.images && hotel.images[0] ? hotel.images[0] : 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= hotel.name %>" class="h-52 w-full object-cover" />
                        <div class="p-5">
                            <div class="flex justify-between items-start gap-3 mb-3">
                                <h2 class="text-xl font-bold leading-tight"><%= hotel.name %></h2>
                                <span class="text-sm font-semibold text-primary">$<%= hotel.price %>/night</span>
                            </div>

                            <p class="text-sm text-gray-600 mb-3"><%= hotel.location %></p>
                            <p class="text-sm text-gray-700 line-clamp-3 mb-4"><%= hotel.description %></p>

                            <div class="flex flex-wrap gap-2 text-xs text-gray-600 mb-4">
                                <span class="bg-gray-100 px-2 py-1 rounded-full"><%= hotel.type %></span>
                                <span class="bg-gray-100 px-2 py-1 rounded-full"><%= hotel.guests %> guests</span>
                                <% if (hotel.categories && hotel.categories.length) { %>
                                    <% hotel.categories.slice(0,2).forEach((category) => { %>
                                        <span class="bg-gray-100 px-2 py-1 rounded-full"><%= category %></span>
                                    <% }) %>
                                <% } %>
                            </div>

                            <a href="/Hot-Stay/booking/<%= hotel._id %>" class="inline-flex items-center text-sm font-semibold text-text hover:text-primary">View listing</a>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </main>
</body>
</html>
