<!DOCTYPE html>
<html lang="en">
<%- include('./includes/head'); %>
<title>My Profile | HotStay</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="bg-background font-jakarta text-text min-h-screen">

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed top-20 right-6 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- Navigation -->
    <nav class="sticky top-0 bg-white/98 backdrop-blur-sm border-b border-gray-200 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <%- include('./includes/logo'); %>
                <div class="flex items-center gap-2 sm:gap-4">
                    <a href="/Hot-Stay/host/hosted-list<%= (typeof user !== 'undefined' && user && user._id) ? ('?id=' + user._id) : '' %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 bg-primary text-white text-xs sm:text-sm font-semibold rounded-lg hover:bg-primary/90 transition shadow-sm">
                        <i class="fa-solid fa-house-chimney-user"></i>
                        <span>My Properties</span>
                    </a>
                    <a href="/Hot-Stay/home" class="text-text hover:text-primary font-medium text-xs sm:text-sm transition-colors">Browse Hotels</a>
                    <button onclick="window.location.href='/Hot-Stay/home'" class="hidden sm:inline-block px-3 py-1.5 sm:px-4 sm:py-2 border-2 border-primary text-primary hover:bg-primary hover:text-white rounded-lg font-medium text-xs sm:text-sm transition-colors">
                        Book Now
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- Page Header -->
        <div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h1 class="text-3xl sm:text-4xl font-bold text-text mb-2">My Profile</h1>
                <p class="text-gray-600">Manage your account, bookings, preferences, and saved stays</p>
            </div>
            <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
                <a href="/Hot-Stay/host/hosted-list<%= (typeof user !== 'undefined' && user && user._id) ? ('?id=' + user._id) : '' %>" class="inline-flex items-center gap-2 px-3.5 py-2 bg-secondary hover:bg-secondary/90 text-white font-medium text-sm rounded-lg shadow-sm transition">
                    <i class="fa-solid fa-hotel"></i>
                    <span>My Properties</span>
                </a>
                <a href="/Hot-Stay/profile/export-data" class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium text-sm rounded-lg shadow-sm transition">
                    <i class="fa-solid fa-download text-primary"></i>
                    <span>Export Data</span>
                </a>
                <button onclick="openEditModal()" class="inline-flex items-center gap-2 px-3.5 py-2 bg-primary hover:bg-primary/90 text-white font-medium text-sm rounded-lg shadow-sm transition">
                    <i class="fa-solid fa-user-pen"></i>
                    <span>Edit Profile</span>
                </button>
            </div>
        </div>

        <!-- Profile Overview Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            
            <!-- Profile Card -->
            <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
                
                <!-- Top Banner -->
                <div class="h-24 bg-gradient-to-r from-primary via-accent to-secondary relative">
                    <% if (user.verified) { %>
                        <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm text-green-700 text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1 shadow-sm">
                            <i class="fa-solid fa-circle-check text-green-500"></i> Verified
                        </span>
                    <% } %>
                </div>

                <div class="px-6 pb-6 -mt-12 text-center">
                    <img 
                        id="userAvatarDisplay"
                        class="w-24 h-24 rounded-full mx-auto border-4 border-white shadow-lg object-cover bg-gray-100"
                        src="<%= user.avatar %>"
                        alt="<%= user.username %>"
                    >

                    <h2 id="userNameDisplay" class="mt-4 text-2xl font-bold text-text">
                        <%= user.firstName %> <%= user.lastName %>
                    </h2>

                    <p id="userHandleDisplay" class="mt-1 text-sm text-gray-600 font-medium">@<%= user.username %></p>

                    <p id="userBioDisplay" class="mt-3 text-xs text-gray-600 leading-relaxed px-2 line-clamp-3">
                        <%= user.bio || 'Passionate traveler exploring the world one stay at a time.' %>
                    </p>

                    <% if (user.averageRating) { %>
                        <div class="mt-3 inline-block bg-yellow-50 rounded-lg px-3 py-1 border border-yellow-200">
                            <div class="flex items-center gap-1">
                                <% for (let i = 0; i < Math.floor(user.averageRating); i++) { %>
                                    <i class="fa-solid fa-star text-yellow-400 text-xs"></i>
                                <% } %>
                                <span class="text-sm font-semibold text-gray-800 ml-1"><%= user.averageRating %> avg rating</span>
                            </div>
                        </div>
                    <% } %>

                    <div class="mt-4 space-y-1 text-xs text-gray-600 border-t border-gray-100 pt-3">
                        <p class="text-gray-500"><i class="fa-regular fa-calendar mr-1.5 text-primary"></i> Member since <%= new Date(user.createdAt || Date.now()).toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) %></p>
                        <p class="break-all"><i class="fa-regular fa-envelope mr-1.5 text-primary"></i> <%= user.email %></p>
                        <% if (user.phone) { %>
                            <p><i class="fa-solid fa-phone mr-1.5 text-primary"></i> <%= user.phone %></p>
                        <% } %>
                        <% if (user.address && (user.address.city || user.address.country)) { %>
                            <p><i class="fa-solid fa-location-dot mr-1.5 text-primary"></i> <%= [user.address.city, user.address.country].filter(Boolean).join(', ') %></p>
                        <% } %>
                    </div>

                    <div class="mt-5 space-y-2">
                        <a href="/Hot-Stay/host/hosted-list<%= (typeof user !== 'undefined' && user && user._id) ? ('?id=' + user._id) : '' %>" class="w-full px-4 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg shadow-sm hover:shadow-md transition duration-300 flex items-center justify-center gap-2 text-sm">
                            <i class="fa-solid fa-house-chimney-user"></i> My Hosted Properties
                        </a>
                        <button onclick="openEditModal()" class="w-full px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition duration-300 flex items-center justify-center gap-2 text-sm">
                            <i class="fa-solid fa-user-pen"></i> Edit Profile
                        </button>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="lg:col-span-2 grid grid-cols-2 sm:grid-cols-2 gap-4">
                
                <!-- Total Bookings -->
                <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-5 flex flex-col justify-between hover:shadow-lg transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Bookings</p>
                            <p class="text-3xl font-bold text-primary mt-2"><%= user.totalBookings %></p>
                        </div>
                        <div class="w-11 h-11 bg-primary/10 rounded-xl flex items-center justify-center text-primary text-xl">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3"><%= user.totalBookings %> lifetime reservations</p>
                </div>

                <!-- Completed Trips -->
                <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-5 flex flex-col justify-between hover:shadow-lg transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Completed Trips</p>
                            <p class="text-3xl font-bold text-accent mt-2"><%= user.totalTrips %></p>
                        </div>
                        <div class="w-11 h-11 bg-accent/10 rounded-xl flex items-center justify-center text-accent text-xl">
                            <i class="fa-solid fa-plane-departure"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3"><%= user.totalTrips %> successful stays</p>
                </div>

                <!-- Total Nights -->
                <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-5 flex flex-col justify-between hover:shadow-lg transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Nights</p>
                            <p class="text-3xl font-bold text-secondary mt-2"><%= user.totalNights %></p>
                        </div>
                        <div class="w-11 h-11 bg-secondary/10 rounded-xl flex items-center justify-center text-secondary text-xl">
                            <i class="fa-solid fa-moon"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3">Nights spent at properties</p>
                </div>

                <!-- Total Spent -->
                <div class="bg-white rounded-2xl shadow-md border border-gray-200 p-5 flex flex-col justify-between hover:shadow-lg transition">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Spent</p>
                            <p class="text-3xl font-bold text-primary mt-2">₹<%= Number(user.totalSpent || 0).toLocaleString('en-IN') %></p>
                        </div>
                        <div class="w-11 h-11 bg-primary/10 rounded-xl flex items-center justify-center text-primary text-xl">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-3">Across all completed stays</p>
                </div>
            </div>
        </div>

        <!-- Upcoming Trips Section -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-2xl font-bold text-text flex items-center gap-2">
                    <span>🚀 Upcoming Trips</span>
                </h2>
                <a href="/Hot-Stay/home" class="text-primary hover:text-primary/80 font-medium transition text-sm">Browse Hotels &rarr;</a>
            </div>
            <% const upcomingBookings = bookings ? bookings.filter(b => b.status === 'Upcoming' || (!b.status && new Date(b.checkIn) > new Date())) : []; %>
            <% if (upcomingBookings.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% upcomingBookings.forEach((booking) => { %>
                        <div id="upcoming-booking-<%= booking._id %>" class="bg-gradient-to-br from-primary/5 via-white to-accent/5 rounded-2xl border-2 border-primary/20 hover:border-primary/50 p-6 transition shadow-sm hover:shadow-md flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-3">
                                        <% if (booking.image) { %>
                                            <img src="<%= booking.image %>" class="w-12 h-12 rounded-lg object-cover" alt="<%= booking.hotelName %>">
                                        <% } %>
                                        <div>
                                            <h3 class="text-lg font-bold text-text"><%= booking.hotelName %></h3>
                                            <p class="text-sm text-gray-600">📍 <%= booking.location %></p>
                                        </div>
                                    </div>
                                    <span class="px-3 py-1 bg-primary text-white text-xs font-semibold rounded-full shadow-sm">Upcoming</span>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mb-4 text-sm">
                                    <div class="bg-white rounded-lg p-2.5 border border-gray-100 shadow-2xs">
                                        <p class="text-xs text-gray-500">Check-in</p>
                                        <p class="font-semibold text-text"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                    </div>
                                    <div class="bg-white rounded-lg p-2.5 border border-gray-100 shadow-2xs">
                                        <p class="text-xs text-gray-500">Check-out</p>
                                        <p class="font-semibold text-text"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                    </div>
                                    <div class="bg-white rounded-lg p-2.5 border border-gray-100 shadow-2xs col-span-2 sm:col-span-1">
                                        <p class="text-xs text-gray-500">Total Price</p>
                                        <p class="font-semibold text-primary">₹<%= Number(booking.price || 0).toLocaleString('en-IN') %></p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 mt-2">
                                <a href="/Hot-Stay/booking/<%= booking.hotelId %>" class="flex-1 text-center px-4 py-2 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition text-sm shadow-xs">
                                    View Booking Details
                                </a>
                                <button onclick="cancelBooking('<%= booking._id %>')" class="px-4 py-2 border border-red-200 text-red-600 hover:bg-red-50 font-semibold rounded-lg transition text-sm">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="bg-white rounded-2xl border border-gray-200 p-10 text-center shadow-xs">
                    <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-400 text-2xl">
                        <i class="fa-solid fa-suitcase-rolling"></i>
                    </div>
                    <p class="text-gray-700 text-lg font-semibold mb-1">No upcoming trips</p>
                    <p class="text-gray-500 text-sm mb-4">Ready for your next memorable getaway?</p>
                    <a href="/Hot-Stay/home" class="inline-block px-6 py-2.5 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition shadow-sm">
                        Start Booking
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Saved Properties Section -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-2xl font-bold text-text flex items-center gap-2">
                    <span>❤️ Saved Properties</span>
                </h2>
                <a href="/Hot-Stay/home" class="text-primary hover:text-primary/80 font-medium transition text-sm">Explore More &rarr;</a>
            </div>
            <% if (savedHotels && savedHotels.length > 0) { %>
                <div id="savedHotelsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
                    <% savedHotels.forEach((hotel) => { %>
                        <div id="saved-hotel-<%= hotel._id %>" class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
                            <div class="relative aspect-4/3 bg-gray-100 overflow-hidden">
                                <img 
                                    src="<%= hotel.images && hotel.images[0] ? hotel.images[0] : 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=500' %>" 
                                    alt="<%= hotel.name %>"
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                >
                                <button 
                                    onclick="toggleSaveHotel('<%= hotel._id %>')" 
                                    title="Remove from saved"
                                    class="absolute top-3 right-3 w-9 h-9 rounded-full bg-white/90 backdrop-blur-sm text-red-500 hover:bg-red-500 hover:text-white flex items-center justify-center transition shadow-sm"
                                >
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                                <span class="absolute bottom-3 left-3 bg-dark/70 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-full font-medium">
                                    <%= hotel.type || 'Hotel' %>
                                </span>
                            </div>
                            <div class="p-4 flex-1 flex flex-col justify-between">
                                <div>
                                    <div class="flex items-start justify-between gap-2 mb-1">
                                        <h3 class="font-bold text-text line-clamp-1"><%= hotel.name %></h3>
                                        <div class="flex items-center gap-1 text-xs font-semibold text-gray-700 shrink-0">
                                            <i class="fa-solid fa-star text-yellow-400"></i>
                                            <span><%= hotel.rating || '4.8' %></span>
                                        </div>
                                    </div>
                                    <p class="text-xs text-gray-500 mb-2">📍 <%= hotel.location %></p>
                                </div>
                                <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                                    <div>
                                        <span class="text-base font-bold text-primary">₹<%= Number(hotel.price || 0).toLocaleString('en-IN') %></span>
                                        <span class="text-xs text-gray-500">/ night</span>
                                    </div>
                                    <a href="/Hot-Stay/booking/<%= hotel._id %>" class="px-3.5 py-1.5 bg-primary hover:bg-primary/90 text-white text-xs font-semibold rounded-lg transition">
                                        Book Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div id="savedHotelsEmpty" class="bg-white rounded-2xl border border-gray-200 p-8 text-center shadow-xs">
                    <div class="w-14 h-14 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-3 text-red-400 text-2xl">
                        <i class="fa-regular fa-heart"></i>
                    </div>
                    <p class="text-gray-700 text-lg font-semibold mb-1">No saved properties yet</p>
                    <p class="text-gray-500 text-sm mb-4">Click the heart icon on any hotel to save it for your next trip!</p>
                    <a href="/Hot-Stay/home" class="inline-block px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition shadow-sm">
                        Explore Hotels
                    </a>
                </div>
            <% } %>
        </div>

        <!-- Tabs Section -->
        <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
            <div class="flex flex-wrap border-b border-gray-200 overflow-x-auto bg-gray-50/50">
                <button id="tabBtn-bookings" class="tab-button active flex-1 min-w-max px-6 py-4 font-semibold text-text transition border-b-4 border-primary flex items-center justify-center gap-2" onclick="showTab('bookings')">
                    <i class="fa-regular fa-calendar-check text-primary"></i> Booking History
                </button>
                <button id="tabBtn-reviews" class="tab-button flex-1 min-w-max px-6 py-4 font-semibold text-gray-600 hover:bg-gray-50 transition border-b-4 border-transparent flex items-center justify-center gap-2" onclick="showTab('reviews')">
                    <i class="fa-regular fa-star text-yellow-500"></i> My Reviews
                </button>
                <button id="tabBtn-settings" class="tab-button flex-1 min-w-max px-6 py-4 font-semibold text-gray-600 hover:bg-gray-50 transition border-b-4 border-transparent flex items-center justify-center gap-2" onclick="showTab('settings')">
                    <i class="fa-solid fa-sliders text-secondary"></i> Settings
                </button>
                <button id="tabBtn-preferences" class="tab-button flex-1 min-w-max px-6 py-4 font-semibold text-gray-600 hover:bg-gray-50 transition border-b-4 border-transparent flex items-center justify-center gap-2" onclick="showTab('preferences')">
                    <i class="fa-solid fa-bullseye text-accent"></i> Preferences
                </button>
            </div>

            <!-- Booking History Tab -->
            <div id="bookings" class="tab-content active p-6">
                <% if (bookings && bookings.length > 0) { %>
                    <div class="space-y-4">
                        <% bookings.forEach((booking) => { %>
                            <div id="booking-item-<%= booking._id %>" class="bg-gray-50 rounded-xl border border-gray-200 hover:shadow-md transition overflow-hidden">
                                <div class="flex flex-col md:flex-row gap-4 p-4">
                                    
                                    <!-- Hotel Image -->
                                    <div class="w-full md:w-32 h-32 flex-shrink-0 bg-gray-200 rounded-lg overflow-hidden">
                                        <img 
                                            src="<%= booking.image || 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=500' %>" 
                                            alt="<%= booking.hotelName %>"
                                            class="w-full h-full object-cover"
                                        >
                                    </div>

                                    <!-- Booking Details -->
                                    <div class="flex-1 min-w-0">
                                        <div class="flex flex-col sm:flex-row justify-between items-start gap-2 mb-2">
                                            <div>
                                                <h4 class="text-lg font-bold text-text"><%= booking.hotelName %></h4>
                                                <p class="text-sm text-gray-600">📍 <%= booking.location %></p>
                                            </div>
                                            <span class="px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap <%= booking.status === 'Completed' ? 'bg-green-100 text-green-700' : (booking.status === 'Cancelled' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700') %>">
                                                <%= booking.status || 'Upcoming' %>
                                            </span>
                                        </div>

                                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-3 text-sm">
                                            <div class="bg-white p-2 rounded-md border border-gray-100">
                                                <p class="text-xs text-gray-500">Check-in</p>
                                                <p class="font-semibold text-text"><%= new Date(booking.checkIn).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                            </div>
                                            <div class="bg-white p-2 rounded-md border border-gray-100">
                                                <p class="text-xs text-gray-500">Check-out</p>
                                                <p class="font-semibold text-text"><%= new Date(booking.checkOut).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></p>
                                            </div>
                                            <div class="bg-white p-2 rounded-md border border-gray-100">
                                                <p class="text-xs text-gray-500">Guests</p>
                                                <p class="font-semibold text-text"><%= booking.guests %> <%= booking.guests > 1 ? 'guests' : 'guest' %></p>
                                            </div>
                                            <div class="bg-white p-2 rounded-md border border-gray-100">
                                                <p class="text-xs text-gray-500">Nights</p>
                                                <p class="font-semibold text-text"><%= booking.nights %></p>
                                            </div>
                                        </div>

                                        <!-- Review Status -->
                                        <% if (booking.status === 'Completed') { %>
                                            <div class="text-sm mt-2">
                                                <% if (booking.reviewed) { %>
                                                    <div class="flex items-center gap-2">
                                                        <div class="flex items-center text-yellow-400">
                                                            <% for (let i = 0; i < (booking.rating || 5); i++) { %>
                                                                <i class="fa-solid fa-star text-xs"></i>
                                                            <% } %>
                                                        </div>
                                                        <span class="font-semibold text-gray-700 text-xs"><%= booking.rating %>/5</span>
                                                        <span class="text-gray-500 text-xs">· You reviewed this</span>
                                                    </div>
                                                <% } else { %>
                                                    <button onclick="openReviewModal('<%= booking._id %>', '<%= booking.hotelName %>')" class="inline-flex items-center gap-1.5 text-secondary hover:text-secondary/80 font-semibold text-xs transition">
                                                        <i class="fa-solid fa-pen-to-square"></i> Leave a review
                                                    </button>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Price and Actions -->
                                    <div class="md:text-right flex flex-col justify-between min-w-max border-t md:border-t-0 pt-3 md:pt-0 border-gray-200">
                                        <div>
                                            <p class="text-gray-500 text-xs">Total Price</p>
                                            <p class="text-2xl font-bold text-primary">₹<%= Number(booking.price || 0).toLocaleString('en-IN') %></p>
                                            <p class="text-xs text-gray-500">₹<%= Math.round((booking.price || 0) / (booking.nights || 1)).toLocaleString('en-IN') %>/night</p>
                                        </div>
                                        <div class="mt-3 flex flex-wrap md:flex-col gap-2">
                                            <a href="/Hot-Stay/booking/<%= booking.hotelId %>" class="px-4 py-2 bg-primary hover:bg-primary/90 text-white text-xs font-semibold rounded-lg transition text-center shadow-xs">
                                                View Details
                                            </a>
                                            <% if (booking.status === 'Upcoming') { %>
                                                <button onclick="cancelBooking('<%= booking._id %>')" class="px-4 py-2 bg-white border border-gray-300 hover:bg-red-50 hover:text-red-600 text-gray-700 text-xs font-semibold rounded-lg transition">
                                                    Cancel Booking
                                                </button>
                                            <% } %>
                                            <% if (booking.status === 'Completed' && !booking.reviewed) { %>
                                                <button onclick="openReviewModal('<%= booking._id %>', '<%= booking.hotelName %>')" class="px-4 py-2 bg-secondary hover:bg-secondary/90 text-white text-xs font-semibold rounded-lg transition">
                                                    Write Review
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3 text-gray-400 text-3xl">
                            <i class="fa-regular fa-calendar-xmark"></i>
                        </div>
                        <p class="text-gray-700 text-lg font-semibold mb-1">No bookings found</p>
                        <p class="text-gray-500 text-sm mb-4">Start exploring amazing destinations and book your first stay!</p>
                        <a href="/Hot-Stay/home" class="inline-block px-6 py-2.5 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition shadow-sm">
                            Browse Hotels
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- Reviews Tab -->
            <div id="reviews" class="tab-content p-6">
                <% const reviewedBookings = bookings ? bookings.filter(b => b.status === 'Completed' && b.reviewed) : []; %>
                <% if (reviewedBookings.length > 0) { %>
                    <div class="space-y-4 max-w-3xl">
                        <% reviewedBookings.forEach((booking) => { %>
                            <div class="bg-gray-50 rounded-xl border border-gray-200 p-5 shadow-2xs hover:shadow-xs transition">
                                <div class="flex justify-between items-start mb-3">
                                    <div>
                                        <h4 class="text-base font-bold text-text"><%= booking.hotelName %></h4>
                                        <p class="text-xs text-gray-500">📍 <%= booking.location %> · Reviewed on <%= new Date(booking.reviewDate || booking.bookingDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
                                    </div>
                                    <div class="flex items-center gap-1 bg-white px-2.5 py-1 rounded-lg border border-gray-200">
                                        <div class="flex text-yellow-400 text-xs">
                                            <% for (let i = 0; i < (booking.rating || 5); i++) { %>
                                                <i class="fa-solid fa-star"></i>
                                            <% } %>
                                        </div>
                                        <span class="text-xs font-bold text-gray-800 ml-1"><%= booking.rating %>.0</span>
                                    </div>
                                </div>
                                <p class="text-gray-700 text-sm leading-relaxed"><%= booking.reviewText || booking.reviewComment || 'A wonderful stay! The ambiance, hospitality, and comfort exceeded expectations.' %></p>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <div class="w-16 h-16 bg-yellow-50 rounded-full flex items-center justify-center mx-auto mb-3 text-yellow-400 text-3xl">
                            <i class="fa-regular fa-star"></i>
                        </div>
                        <p class="text-gray-700 text-lg font-semibold mb-1">No reviews yet</p>
                        <p class="text-gray-500 text-sm mb-4">Complete a booking and share your experience with other travelers!</p>
                        <a href="/Hot-Stay/home" class="inline-block px-6 py-2 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition text-sm">
                            Browse Hotels
                        </a>
                    </div>
                <% } %>
            </div>

            <!-- Settings Tab -->
            <div id="settings" class="tab-content p-6">
                <div class="space-y-8 max-w-2xl">
                    
                    <!-- Communication Preferences Form -->
                    <form id="settingsForm" onsubmit="handleSettingsSubmit(event)">
                        <div class="border-b border-gray-200 pb-6 mb-6">
                            <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                                <span>📧 Communication Preferences</span>
                            </h4>
                            <p class="text-xs text-gray-500 mb-4">Choose what notifications and updates you receive from HotStay</p>
                            <div class="space-y-3">
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="bookingUpdates" <%= (user.settings && user.settings.communication && user.settings.communication.bookingUpdates) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Booking confirmations and itinerary updates</span>
                                </label>
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="promotions" <%= (user.settings && user.settings.communication && user.settings.communication.promotions) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Special offers, seasonal deals, and discount codes</span>
                                </label>
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="newsletter" <%= (user.settings && user.settings.communication && user.settings.communication.newsletter) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Weekly newsletter and curated travel recommendations</span>
                                </label>
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="sms" <%= (user.settings && user.settings.communication && user.settings.communication.sms) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Instant SMS notifications for check-in alerts</span>
                                </label>
                            </div>
                        </div>

                        <!-- Privacy Settings -->
                        <div class="border-b border-gray-200 pb-6 mb-6">
                            <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                                <span>🔒 Privacy & Data</span>
                            </h4>
                            <p class="text-xs text-gray-500 mb-4">Control how your information is displayed to other community members</p>
                            <div class="space-y-3">
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="profileVisible" <%= (user.settings && user.settings.privacy && user.settings.privacy.profileVisible) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Make my profile visible to hosts and other users</span>
                                </label>
                                <label class="flex items-center cursor-pointer group">
                                    <input type="checkbox" name="reviewsPublic" <%= (user.settings && user.settings.privacy && user.settings.privacy.reviewsPublic) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                    <span class="ml-3 text-gray-700 text-sm font-medium group-hover:text-primary transition">Share my written reviews publicly</span>
                                </label>
                                <div class="pt-2 flex items-center gap-3">
                                    <a href="/Hot-Stay/profile/export-data" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-text text-sm font-semibold rounded-lg transition inline-flex items-center gap-2">
                                        <i class="fa-solid fa-file-arrow-down"></i> Download My Data (JSON)
                                    </a>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg shadow-sm transition">
                            Save Settings
                        </button>
                    </form>

                    <!-- Security Settings -->
                    <div class="border-b border-gray-200 pb-6">
                        <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                            <span>🔐 Security</span>
                        </h4>
                        <p class="text-xs text-gray-500 mb-4">Keep your account safe and up to date</p>
                        <div class="space-y-3">
                            <button onclick="openPasswordModal()" class="w-full px-4 py-3 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-text font-semibold rounded-lg transition flex items-center justify-between">
                                <span class="flex items-center gap-2 text-sm">
                                    <i class="fa-solid fa-key text-primary"></i> Change Account Password
                                </span>
                                <i class="fa-solid fa-chevron-right text-gray-400 text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Danger Zone -->
                    <div class="bg-red-50/70 border border-red-200 rounded-xl p-5">
                        <h4 class="text-base font-bold text-red-700 mb-1 flex items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation"></i> Danger Zone
                        </h4>
                        <p class="text-xs text-red-600/90 mb-4">Deleting your account is permanent. All profile details, preferences, and booking history will be completely erased.</p>
                        <button onclick="openDeleteModal()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-semibold rounded-lg transition shadow-xs">
                            Delete Account
                        </button>
                    </div>
                </div>
            </div>

            <!-- Preferences Tab -->
            <div id="preferences" class="tab-content p-6">
                <form id="preferencesForm" onsubmit="handlePreferencesSubmit(event)" class="space-y-6 max-w-2xl">
                    
                    <!-- Travel Preferences -->
                    <div class="border-b border-gray-200 pb-6">
                        <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                            <span>✈️ Travel Preferences</span>
                        </h4>
                        <p class="text-xs text-gray-500 mb-4">Personalize your accommodation and booking recommendations</p>
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Preferred Room Type</label>
                                <select name="roomType" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm bg-white">
                                    <option value="Any" <%= (user.preferences && user.preferences.roomType === 'Any') ? 'selected' : '' %>>Any</option>
                                    <option value="Single" <%= (user.preferences && user.preferences.roomType === 'Single') ? 'selected' : '' %>>Single Room</option>
                                    <option value="Double" <%= (user.preferences && user.preferences.roomType === 'Double') ? 'selected' : '' %>>Double Room</option>
                                    <option value="Suite" <%= (user.preferences && user.preferences.roomType === 'Suite') ? 'selected' : '' %>>Suite</option>
                                    <option value="Luxury" <%= (user.preferences && user.preferences.roomType === 'Luxury') ? 'selected' : '' %>>Luxury Villa / Penthouse</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Travel Frequency</label>
                                <select name="travelFrequency" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm bg-white">
                                    <option value="Rarely" <%= (user.preferences && user.preferences.travelFrequency === 'Rarely') ? 'selected' : '' %>>Rarely (1-2 times a year)</option>
                                    <option value="Occasionally" <%= (user.preferences && user.preferences.travelFrequency === 'Occasionally') ? 'selected' : '' %>>Occasionally (3-5 times a year)</option>
                                    <option value="Frequently" <%= (user.preferences && user.preferences.travelFrequency === 'Frequently') ? 'selected' : '' %>>Frequently (Monthly traveler)</option>
                                    <option value="Very Frequently" <%= (user.preferences && user.preferences.travelFrequency === 'Very Frequently') ? 'selected' : '' %>>Very Frequently (Digital Nomad / Weekly)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">Preferred Price Range</label>
                                <select name="priceRange" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm bg-white">
                                    <option value="Budget" <%= (user.preferences && user.preferences.priceRange === 'Budget') ? 'selected' : '' %>>Budget Friendly (Under ₹3,000/night)</option>
                                    <option value="Mid-Range" <%= (user.preferences && user.preferences.priceRange === 'Mid-Range') ? 'selected' : '' %>>Mid-Range (₹3,000 - ₹8,000/night)</option>
                                    <option value="Premium" <%= (user.preferences && user.preferences.priceRange === 'Premium') ? 'selected' : '' %>>Premium (₹8,000 - ₹15,000/night)</option>
                                    <option value="Luxury" <%= (user.preferences && user.preferences.priceRange === 'Luxury') ? 'selected' : '' %>>Ultra Luxury (₹15,000+/night)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Location Preferences -->
                    <div class="border-b border-gray-200 pb-6">
                        <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                            <span>📍 Favorite Destinations</span>
                        </h4>
                        <p class="text-xs text-gray-500 mb-3">Select the landscapes you enjoy staying at</p>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="locBeach" <%= (user.preferences && user.preferences.locations && user.preferences.locations.beach) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2.5 text-sm font-medium text-gray-700">🏖️ Beach Destinations</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="locMountain" <%= (user.preferences && user.preferences.locations && user.preferences.locations.mountain) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2.5 text-sm font-medium text-gray-700">🏔️ Mountain Retreats</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="locCity" <%= (user.preferences && user.preferences.locations && user.preferences.locations.city) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2.5 text-sm font-medium text-gray-700">🏙️ City Centers</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="locRural" <%= (user.preferences && user.preferences.locations && user.preferences.locations.rural) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2.5 text-sm font-medium text-gray-700">🌲 Countryside & Rural</span>
                            </label>
                        </div>
                    </div>

                    <!-- Amenity Preferences -->
                    <div>
                        <h4 class="text-lg font-semibold text-text mb-1 flex items-center gap-2">
                            <span>🏨 Essential Amenities</span>
                        </h4>
                        <p class="text-xs text-gray-500 mb-3">Amenities you prioritize when picking a hotel</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="amenityPool" <%= (user.preferences && user.preferences.amenities && user.preferences.amenities.pool) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2 text-sm font-medium text-gray-700">🏊 Swimming Pool</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="amenityGym" <%= (user.preferences && user.preferences.amenities && user.preferences.amenities.gym) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2 text-sm font-medium text-gray-700">💪 Fitness Center</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="amenityRestaurant" <%= (user.preferences && user.preferences.amenities && user.preferences.amenities.restaurant) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2 text-sm font-medium text-gray-700">🍽️ Restaurant & Bar</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="amenitySpa" <%= (user.preferences && user.preferences.amenities && user.preferences.amenities.spa) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2 text-sm font-medium text-gray-700">💆 Spa & Wellness</span>
                            </label>
                            <label class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-gray-50 cursor-pointer transition">
                                <input type="checkbox" name="amenityWifi" <%= (user.preferences && user.preferences.amenities && user.preferences.amenities.wifi) ? 'checked' : '' %> class="w-4 h-4 text-primary rounded focus:ring-2 focus:ring-primary/50">
                                <span class="ml-2 text-sm font-medium text-gray-700">📶 High-Speed WiFi</span>
                            </label>
                        </div>
                        <button type="submit" class="w-full sm:w-auto px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg shadow-sm transition">
                            Save Preferences
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <%- include('./includes/foot'); %>

    <!-- Edit Profile Modal -->
    <div id="editModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-gradient-to-r from-primary via-accent to-secondary p-6 border-b border-gray-200 z-10">
                <div class="flex justify-between items-center">
                    <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-user-pen"></i> Edit Profile
                    </h2>
                    <button onclick="closeEditModal()" class="text-white hover:bg-white/20 rounded-lg p-2 transition">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <form id="editProfileForm" onsubmit="handleProfileUpdate(event)" class="p-6 space-y-6">
                <!-- Profile Picture -->
                <div class="text-center">
                    <img 
                        id="profilePreview"
                        class="w-32 h-32 rounded-full mx-auto border-4 border-gray-200 shadow-md object-cover mb-4 bg-gray-100"
                        src="<%= user.avatar %>"
                        alt="<%= user.username %>"
                    >
                    <input type="hidden" name="avatar" id="avatarDataInput" value="<%= user.avatar %>">
                    <input type="file" id="avatarInput" class="hidden" accept="image/*" onchange="previewAvatar()">
                    <div class="flex justify-center gap-2">
                        <button type="button" onclick="document.getElementById('avatarInput').click()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition text-sm">
                            📸 Change Photo
                        </button>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-base font-bold text-text mb-4">Personal Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">First Name</label>
                            <input type="text" name="firstName" value="<%= user.firstName %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="First name" required>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">Last Name</label>
                            <input type="text" name="lastName" value="<%= user.lastName %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="Last name">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">Username</label>
                            <input type="text" name="username" value="<%= user.username %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="Username" required>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">Email</label>
                            <input type="email" name="email" value="<%= user.email %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="Email" required>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">Phone</label>
                            <input type="tel" name="phone" value="<%= user.phone %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="Phone number">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">Date of Birth</label>
                            <input type="date" name="dob" value="<%= user.dob %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm">
                        </div>
                    </div>
                </div>

                <!-- Bio -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-base font-bold text-text mb-2">About You</h3>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1.5">Bio</label>
                        <textarea name="bio" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" rows="3" placeholder="Tell hosts and travelers about yourself..." maxlength="250"><%= user.bio %></textarea>
                        <p class="text-xs text-gray-400 mt-1">Up to 250 characters</p>
                    </div>
                </div>

                <!-- Address Information -->
                <div class="border-t border-gray-200 pt-6">
                    <h3 class="text-base font-bold text-text mb-4">Location & Address</h3>
                    <div class="space-y-4">
                        <input type="text" name="street" value="<%= (user.address && user.address.street) ? user.address.street : '' %>" placeholder="Street Address" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <input type="text" name="city" value="<%= (user.address && user.address.city) ? user.address.city : '' %>" placeholder="City" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm">
                            <input type="text" name="state" value="<%= (user.address && user.address.state) ? user.address.state : '' %>" placeholder="State/Province" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm">
                            <input type="text" name="postalCode" value="<%= (user.address && user.address.postalCode) ? user.address.postalCode : '' %>" placeholder="Postal Code" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm">
                        </div>
                        <select name="country" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm bg-white">
                            <option value="India" <%= (!user.address || !user.address.country || user.address.country === 'India') ? 'selected' : '' %>>India</option>
                            <option value="United States" <%= (user.address && user.address.country === 'United States') ? 'selected' : '' %>>United States</option>
                            <option value="United Kingdom" <%= (user.address && user.address.country === 'United Kingdom') ? 'selected' : '' %>>United Kingdom</option>
                            <option value="Canada" <%= (user.address && user.address.country === 'Canada') ? 'selected' : '' %>>Canada</option>
                            <option value="Australia" <%= (user.address && user.address.country === 'Australia') ? 'selected' : '' %>>Australia</option>
                            <option value="Germany" <%= (user.address && user.address.country === 'Germany') ? 'selected' : '' %>>Germany</option>
                            <option value="Other" <%= (user.address && user.address.country === 'Other') ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="border-t border-gray-200 pt-6 flex gap-3 justify-end">
                    <button type="button" onclick="closeEditModal()" class="px-6 py-2.5 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition text-sm">
                        Cancel
                    </button>
                    <button type="submit" id="saveProfileBtn" class="px-6 py-2.5 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition text-sm shadow-sm">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Review Modal -->
    <div id="reviewModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden">
            <div class="bg-gradient-to-r from-secondary to-primary p-5 text-white flex justify-between items-center">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-star text-yellow-300"></i> Leave a Review
                </h3>
                <button onclick="closeReviewModal()" class="text-white hover:bg-white/20 rounded-lg p-1.5 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form id="reviewForm" onsubmit="handleReviewSubmit(event)" class="p-6 space-y-5">
                <input type="hidden" id="reviewBookingId" name="bookingId">
                <div>
                    <p class="text-sm font-semibold text-gray-700 mb-1" id="reviewHotelName">Hotel Name</p>
                    <p class="text-xs text-gray-500">How was your stay? Tap a star to rate.</p>
                </div>

                <!-- Interactive Star Rating -->
                <div class="flex items-center gap-2 py-2">
                    <div class="flex gap-2 text-3xl cursor-pointer" id="starRatingContainer">
                        <i class="fa-solid fa-star text-yellow-400 star-btn" data-rating="1" onclick="setRating(1)"></i>
                        <i class="fa-solid fa-star text-yellow-400 star-btn" data-rating="2" onclick="setRating(2)"></i>
                        <i class="fa-solid fa-star text-yellow-400 star-btn" data-rating="3" onclick="setRating(3)"></i>
                        <i class="fa-solid fa-star text-yellow-400 star-btn" data-rating="4" onclick="setRating(4)"></i>
                        <i class="fa-solid fa-star text-yellow-400 star-btn" data-rating="5" onclick="setRating(5)"></i>
                    </div>
                    <span id="ratingValueLabel" class="text-sm font-bold text-gray-700 ml-2">5.0 / 5</span>
                    <input type="hidden" id="ratingInput" name="rating" value="5">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5">Your Review Comment</label>
                    <textarea id="reviewText" name="reviewText" rows="4" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="Write about the location, amenities, cleanliness, and overall experience..." required></textarea>
                </div>

                <div class="flex gap-3 justify-end pt-2">
                    <button type="button" onclick="closeReviewModal()" class="px-5 py-2 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition text-sm">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 bg-secondary hover:bg-secondary/90 text-white font-semibold rounded-lg transition text-sm shadow-sm">
                        Submit Review
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div id="passwordModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden">
            <div class="bg-gradient-to-r from-primary to-accent p-5 text-white flex justify-between items-center">
                <h3 class="text-xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-key"></i> Change Password
                </h3>
                <button onclick="closePasswordModal()" class="text-white hover:bg-white/20 rounded-lg p-1.5 transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form id="passwordForm" onsubmit="handlePasswordChange(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5">Current Password</label>
                    <input type="password" name="currentPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="••••••••" required>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5">New Password</label>
                    <input type="password" name="newPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="••••••••" minlength="6" required>
                    <p class="text-xs text-gray-400 mt-1">Minimum 6 characters</p>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1.5">Confirm New Password</label>
                    <input type="password" name="confirmPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary/50 focus:border-transparent text-sm" placeholder="••••••••" minlength="6" required>
                </div>

                <div class="flex gap-3 justify-end pt-3">
                    <button type="button" onclick="closePasswordModal()" class="px-5 py-2 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition text-sm">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 bg-primary hover:bg-primary/90 text-white font-semibold rounded-lg transition text-sm shadow-sm">
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Account Confirmation Modal -->
    <div id="deleteModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 text-center">
            <div class="w-16 h-16 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <h3 class="text-xl font-bold text-text mb-2">Delete Account?</h3>
            <p class="text-sm text-gray-600 mb-6">Are you sure you want to permanently delete your HotStay account? All your bookings and personal information will be completely erased.</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeDeleteModal()" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-text font-semibold rounded-lg transition text-sm">
                    Keep My Account
                </button>
                <button onclick="confirmAccountDeletion()" class="px-5 py-2.5 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-lg transition text-sm shadow-sm">
                    Yes, Delete Everything
                </button>
            </div>
        </div>
    </div>

    <script>
        // Toast notification helper
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            const isSuccess = type === 'success';
            toast.className = `pointer-events-auto px-5 py-3.5 rounded-xl shadow-xl flex items-center gap-3 text-sm font-semibold transition-all transform duration-300 translate-y-2 opacity-0 ${
                isSuccess ? 'bg-gray-900 text-white border border-gray-700' : 'bg-red-600 text-white'
            }`;
            toast.innerHTML = `
                <i class="fa-solid ${isSuccess ? 'fa-circle-check text-green-400' : 'fa-circle-exclamation text-white'} text-base"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', '-translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // Modal Management
        function openEditModal() {
            document.getElementById('editModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function openReviewModal(bookingId, hotelName) {
            document.getElementById('reviewBookingId').value = bookingId;
            document.getElementById('reviewHotelName').textContent = hotelName || 'Hotel Stay';
            setRating(5);
            document.getElementById('reviewText').value = '';
            document.getElementById('reviewModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeReviewModal() {
            document.getElementById('reviewModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function setRating(rating) {
            document.getElementById('ratingInput').value = rating;
            document.getElementById('ratingValueLabel').textContent = `${rating}.0 / 5`;
            const stars = document.querySelectorAll('#starRatingContainer .star-btn');
            stars.forEach((star, index) => {
                if (index < rating) {
                    star.className = 'fa-solid fa-star text-yellow-400 star-btn';
                } else {
                    star.className = 'fa-regular fa-star text-gray-300 star-btn';
                }
            });
        }

        function openPasswordModal() {
            document.getElementById('passwordForm').reset();
            document.getElementById('passwordModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function openDeleteModal() {
            document.getElementById('deleteModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        // Avatar Preview & Base64 Converter
        function previewAvatar() {
            const file = document.getElementById('avatarInput').files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profilePreview').src = e.target.result;
                    document.getElementById('avatarDataInput').value = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        // Tab Switching
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('active');
                btn.classList.remove('border-primary', 'text-text');
                btn.classList.add('border-transparent', 'text-gray-600');
            });
            
            const targetTab = document.getElementById(tabName);
            if (targetTab) {
                targetTab.classList.add('active');
            }
            
            const button = document.getElementById(`tabBtn-${tabName}`) || event?.target?.closest('.tab-button');
            if (button) {
                button.classList.add('active', 'border-primary', 'text-text');
                button.classList.remove('border-transparent', 'text-gray-600');
            }
        }

        // Handle Profile Update Submission
        async function handleProfileUpdate(e) {
            e.preventDefault();
            const btn = document.getElementById('saveProfileBtn');
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const form = e.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/Hot-Stay/profile/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Profile updated successfully!');
                    closeEditModal();
                    document.getElementById('userNameDisplay').textContent = `${data.firstName || ''} ${data.lastName || ''}`.trim();
                    document.getElementById('userHandleDisplay').textContent = `@${data.username}`;
                    document.getElementById('userBioDisplay').textContent = data.bio || '';
                    if (data.avatar) {
                        document.getElementById('userAvatarDisplay').src = data.avatar;
                    }
                } else {
                    showToast(result.message || 'Failed to update profile', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('An error occurred while saving profile', 'error');
            } finally {
                btn.disabled = false;
                btn.textContent = 'Save Changes';
            }
        }

        // Handle Settings Submission
        async function handleSettingsSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const data = {
                bookingUpdates: form.bookingUpdates.checked,
                promotions: form.promotions.checked,
                newsletter: form.newsletter.checked,
                sms: form.sms.checked,
                profileVisible: form.profileVisible.checked,
                reviewsPublic: form.reviewsPublic.checked
            };

            try {
                const response = await fetch('/Hot-Stay/profile/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Settings saved successfully!');
                } else {
                    showToast(result.message || 'Failed to save settings', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error saving settings', 'error');
            }
        }

        // Handle Preferences Submission
        async function handlePreferencesSubmit(e) {
            e.preventDefault();
            const form = e.target;
            const data = {
                roomType: form.roomType.value,
                travelFrequency: form.travelFrequency.value,
                priceRange: form.priceRange.value,
                locBeach: form.locBeach.checked,
                locMountain: form.locMountain.checked,
                locCity: form.locCity.checked,
                locRural: form.locRural.checked,
                amenityPool: form.amenityPool.checked,
                amenityGym: form.amenityGym.checked,
                amenityRestaurant: form.amenityRestaurant.checked,
                amenitySpa: form.amenitySpa.checked,
                amenityWifi: form.amenityWifi.checked
            };

            try {
                const response = await fetch('/Hot-Stay/profile/preferences', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Preferences updated successfully!');
                } else {
                    showToast(result.message || 'Failed to save preferences', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error saving preferences', 'error');
            }
        }

        // Handle Password Change
        async function handlePasswordChange(e) {
            e.preventDefault();
            const form = e.target;
            const currentPassword = form.currentPassword.value;
            const newPassword = form.newPassword.value;
            const confirmPassword = form.confirmPassword.value;

            if (newPassword !== confirmPassword) {
                showToast('New passwords do not match', 'error');
                return;
            }

            try {
                const response = await fetch('/Hot-Stay/profile/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword, confirmPassword })
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Password updated successfully!');
                    closePasswordModal();
                } else {
                    showToast(result.message || 'Failed to update password', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error updating password', 'error');
            }
        }

        // Handle Review Submission
        async function handleReviewSubmit(e) {
            e.preventDefault();
            const bookingId = document.getElementById('reviewBookingId').value;
            const rating = document.getElementById('ratingInput').value;
            const reviewText = document.getElementById('reviewText').value;

            try {
                const response = await fetch(`/Hot-Stay/booking/${bookingId}/review`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ rating, reviewText })
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Review submitted successfully!');
                    closeReviewModal();
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    showToast(result.message || 'Failed to submit review', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error submitting review', 'error');
            }
        }

        // Cancel Booking
        async function cancelBooking(bookingId) {
            if (!confirm('Are you sure you want to cancel this booking?')) return;

            try {
                const response = await fetch(`/Hot-Stay/booking/${bookingId}/cancel`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    showToast('Booking cancelled');
                    const upcomingCard = document.getElementById(`upcoming-booking-${bookingId}`);
                    if (upcomingCard) upcomingCard.remove();
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    showToast(result.message || 'Failed to cancel booking', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error cancelling booking', 'error');
            }
        }

        // Toggle Saved Hotel (Wishlist)
        async function toggleSaveHotel(hotelId) {
            try {
                const response = await fetch(`/Hot-Stay/hotel/${hotelId}/toggle-save`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    showToast(result.message);
                    const hotelCard = document.getElementById(`saved-hotel-${hotelId}`);
                    if (hotelCard) {
                        hotelCard.style.transition = 'all 0.3s ease';
                        hotelCard.style.opacity = '0';
                        hotelCard.style.transform = 'scale(0.9)';
                        setTimeout(() => {
                            hotelCard.remove();
                            const grid = document.getElementById('savedHotelsGrid');
                            if (grid && grid.children.length === 0) {
                                window.location.reload();
                            }
                        }, 300);
                    }
                } else {
                    showToast(result.message || 'Failed to update saved stays', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error updating saved stays', 'error');
            }
        }

        // Confirm Account Deletion
        async function confirmAccountDeletion() {
            try {
                const response = await fetch('/Hot-Stay/profile/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }
                });
                const result = await response.json();
                if (result.success) {
                    alert('Your account has been deleted. Redirecting to registration.');
                    window.location.href = result.redirectUrl || '/Hot-Stay/register';
                } else {
                    showToast(result.message || 'Failed to delete account', 'error');
                }
            } catch (err) {
                console.error(err);
                showToast('Error deleting account', 'error');
            }
        }

        // Check for server message query param or active tab on load
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const serverMsg = urlParams.get('message');
            const tabParam = urlParams.get('tab');
            if (serverMsg) {
                showToast(serverMsg);
            }
            if (tabParam) {
                showTab(tabParam);
            }
        });

        // Close modals on backdrop click
        ['editModal', 'reviewModal', 'passwordModal', 'deleteModal'].forEach(id => {
            const modal = document.getElementById(id);
            if (modal) {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        this.classList.add('hidden');
                        document.body.style.overflow = 'auto';
                    }
                });
            }
        });
    </script>

    <style>
        .tab-content {
            display: none;
        }
        .tab-content.active {
            display: block;
        }
        .hidden {
            display: none !important;
        }
    </style>

</body>
</html>